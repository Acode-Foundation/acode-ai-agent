{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["acode-plugin-types"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "pi-codemode-internal/prelude": [
        "./node_modules/@earendil-works/pi-codemode/dist/runtime/prelude-source"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["./dist/**/*"]
}
